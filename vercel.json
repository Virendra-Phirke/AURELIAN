{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "server": {
      "root": "backend",
      "entrypoint": "server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
